<UserControl x:Class="ShuiMan.Windows.LibraryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ShuiMan.Windows"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#20232C"
 Background="#F7F7FA" AllowDrop="True" DragOver="LibraryDragOver" Drop="LibraryDrop">
 <UserControl.Resources>
  <Style x:Key="LibraryNav" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#545B6D"/>
   <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E4E7F0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5676D9"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CoverButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="Transparent" CornerRadius="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#5676D9"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="CoverTemplate" DataType="{x:Type local:LibraryBookCard}">
   <local:LibraryCoverFrame CornerRadius="8" Background="{Binding PlaceholderBrush}" ClipToBounds="True" Opacity="{Binding CoverOpacity}">
    <Grid>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
      <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Light" Foreground="#6B7587" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Format}" FontSize="10" Foreground="#818A9A" Margin="0,12,0,0" HorizontalAlignment="Center"/>
     </StackPanel>
     <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Border Background="#EAF0F7" CornerRadius="4" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,3" Visibility="{Binding MissingVisibility}"><TextBlock Text="文件失联" FontSize="10" Foreground="#6E778A"/></Border>
    </Grid>
   </local:LibraryCoverFrame>
  </DataTemplate>
  <DataTemplate x:Key="BookCardTemplate" DataType="{x:Type local:LibraryBookCard}">
   <StackPanel Width="180" Margin="0,0,23,26">
    <Button Style="{StaticResource CoverButton}" Click="OpenBookClick" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Title}">
     <Border Height="238" CornerRadius="8"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.12" Color="#3C4252"/></Border.Effect><ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}"/></Border>
    </Button>
    <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
     <Button Grid.Column="1" Width="24" Height="24" MinHeight="24" Style="{DynamicResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteHint}" Click="FavoriteClick" FontSize="13" Padding="3" Margin="0" Visibility="{Binding BookActionsVisibility}"/>
    </Grid>
    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="#818593" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Column="1" Width="24" Height="24" MinHeight="24" Style="{DynamicResource IconButton}" Content="···" ToolTip="书籍操作" Click="MoreClick" Padding="3,0" Margin="0" Visibility="{Binding BookActionsVisibility}"/>
    </Grid>
    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,7,0,0" Foreground="#738CE0" Background="#E7E9F0" BorderThickness="0" Visibility="{Binding ProgressVisibility}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="BookRowTemplate" DataType="{x:Type local:LibraryBookCard}">
   <Border BorderBrush="#E9EAF0" BorderThickness="0,0,0,1" Padding="0,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource CoverButton}" Click="OpenBookClick" ToolTip="{Binding Description}" Height="76" Width="56"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}"/></Button>
     <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#818593" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TagsText}" Foreground="#5676D9" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Metadata}" Foreground="#818593" FontSize="11"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,8,20,0" Foreground="#738CE0" Background="#E7E9F0" BorderThickness="0" Visibility="{Binding ProgressVisibility}"/></StackPanel>
     <Button Grid.Column="3" Style="{DynamicResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteHint}" Click="FavoriteClick" Visibility="{Binding BookActionsVisibility}"/>
     <Button Grid.Column="4" Style="{DynamicResource IconButton}" Content="···" ToolTip="书籍操作" Click="MoreClick" Visibility="{Binding BookActionsVisibility}"/>
     <Button Grid.Column="5" Style="{DynamicResource GhostButton}" Content="阅读" Click="OpenBookClick" Padding="10,7" IsEnabled="{Binding Available}"/>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F1F5" BorderBrush="#E6E7EF" BorderThickness="0,0,1,0">
   <Grid Margin="18,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="14,0,0,30"><TextBlock Text="我的空间" FontSize="17" FontWeight="SemiBold" Foreground="#586175"/><TextBlock Text="让故事，自然流动。" Foreground="#9398A7" FontSize="10" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="书库" Foreground="#9398A7" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,9"/>
     <Button x:Name="SeriesNav" Style="{StaticResource LibraryNav}" Tag="series" Click="NavigationClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="15"/><TextBlock Grid.Column="1" Text="系列书库"/></Grid></Button>
     <Button x:Name="AllNav" Style="{StaticResource LibraryNav}" Tag="all" Click="NavigationClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="15"/><TextBlock Grid.Column="1" Text="所有分卷"/><TextBlock x:Name="AllCount" Grid.Column="2" FontSize="11" Foreground="#9398A7"/></Grid></Button>
     <Button x:Name="ReadingNav" Style="{StaticResource LibraryNav}" Tag="reading" Click="NavigationClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE81C;" FontSize="15"/><TextBlock Grid.Column="1" Text="正在阅读"/><TextBlock x:Name="ReadingCount" Grid.Column="2" FontSize="11" Foreground="#9398A7"/></Grid></Button>
     <Button x:Name="FavoritesNav" Style="{StaticResource LibraryNav}" Tag="favorites" Click="NavigationClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE734;" FontSize="15"/><TextBlock Grid.Column="1" Text="我的收藏"/><TextBlock x:Name="FavoriteCount" Grid.Column="2" FontSize="11" Foreground="#9398A7"/></Grid></Button>
     <Border Background="#DFE2EA" Height="1" Margin="12,23,12,19"/>
     <TextBlock Text="管理" Foreground="#9398A7" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,9"/>
     <Button x:Name="FoldersNav" Style="{StaticResource LibraryNav}" Tag="folders" Click="NavigationClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="15"/><TextBlock Grid.Column="1" Text="漫画来源"/></Grid></Button>
    </StackPanel>
    <StackPanel Grid.Row="3"><Button Style="{DynamicResource GhostButton}" Content="＋  添加漫画" HorizontalContentAlignment="Center" Click="ChooseFilesClick" Margin="0,0,0,13"/><TextBlock Text="你的书籍，留在本地。" Foreground="#A0A5B2" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,29,30,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><Button x:Name="SeriesBack" Content="‹  全部系列" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="-8,0,0,5" Visibility="Collapsed" Click="SeriesBackClick"/><TextBlock x:Name="SectionTitle" Text="系列书库" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="SectionSubtitle" Text="为喜欢的故事，留一个位置。" Foreground="#818593" FontSize="12" Margin="1,9,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{DynamicResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;" ToolTip="重新扫描漫画来源" Click="RefreshSourcesClick" Margin="0,0,8,0"/><Button Content="＋  导入漫画" Style="{DynamicResource PrimaryButton}" Click="ChooseFilesClick" Padding="17,10"/></StackPanel>
   </Grid>
   <Grid x:Name="FilterBar" Grid.Row="1" Margin="0,25,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E6E7ED" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" Foreground="#949AA7" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Margin="0" Padding="0,9,12,9" TextChanged="SearchChanged" ToolTip="搜索书名、系列或标签" AutomationProperties.Name="搜索漫画"/><TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索书名、系列或标签" Foreground="#A3A7B3" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
    <ComboBox x:Name="StateBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,10,0" ToolTip="阅读状态"><ComboBoxItem Content="全部状态" Tag="全部"/><ComboBoxItem Content="未读" Tag="未读"/><ComboBoxItem Content="在读" Tag="在读"/><ComboBoxItem Content="已读" Tag="已读"/></ComboBox>
    <ComboBox x:Name="SortBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,12,0" ToolTip="排列方式"><ComboBoxItem Content="最近阅读" Tag="recent"/><ComboBoxItem Content="名称顺序" Tag="title"/><ComboBoxItem Content="按系列" Tag="series"/><ComboBoxItem Content="最近添加" Tag="added"/></ComboBox>
    <Border Grid.Column="3" BorderBrush="#E3E5ED" BorderThickness="1" CornerRadius="7" Padding="3" Background="#F0F1F6"><StackPanel Orientation="Horizontal"><Button x:Name="GridModeButton" Style="{DynamicResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE80A;" ToolTip="封面网格" Click="GridModeClick"/><Button x:Name="ListModeButton" Style="{DynamicResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8FD;" ToolTip="详细列表" Click="ListModeClick"/></StackPanel></Border>
   </Grid>
   <Border x:Name="MessageBanner" Grid.Row="2" Visibility="Collapsed" Background="#EAF0FC" CornerRadius="8" Padding="12,10" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#5B6E97" FontSize="12"/><Button x:Name="CancelImportButton" Grid.Column="1" Content="取消" Click="CancelImportClick" Style="{DynamicResource GhostButton}" Padding="9,2" Visibility="Collapsed"/></Grid></Border>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border x:Name="ResumePanel" Background="#ECEFF8" CornerRadius="12" Padding="22,18" Margin="0,0,10,27" Visibility="Collapsed">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="62" Height="82" CornerRadius="6"><ContentControl x:Name="ResumeCover" ContentTemplate="{StaticResource CoverTemplate}"/></Border><StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="继续上次的故事" FontSize="11" Foreground="#7B85A1"/><TextBlock x:Name="ResumeTitle" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ResumeProgress" Foreground="#818BA4" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="2" Content="继续阅读  ›" Style="{DynamicResource PrimaryButton}" VerticalAlignment="Center" Click="ResumeClick" Padding="17,10"/></Grid>
      </Border>
      <ItemsControl x:Name="BookGrid" ItemTemplate="{StaticResource BookCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <ItemsControl x:Name="BookList" ItemTemplate="{StaticResource BookRowTemplate}" Visibility="Collapsed" Margin="0,0,12,0"/>
     </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" Margin="20,0,20,50">
     <Border Background="#EDEFF6" Width="84" Height="84" CornerRadius="25" HorizontalAlignment="Center"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="33" Foreground="#A1ADC9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="EmptyTitle" Text="你的下一段故事，从这里开始" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" Margin="0,26,0,12"/>
     <TextBlock x:Name="EmptyDescription" Text="添加漫画文件，或选择一个收藏目录。&#xA;ZIP / CBZ、EPUB、PDF 与图片集，都能安放于此。" FontSize="12" Foreground="#8B91A1" TextAlignment="Center" LineHeight="22" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,23,0,0"><Button x:Name="EmptyImport" Content="添加漫画文件" Style="{DynamicResource PrimaryButton}" Click="ChooseFilesClick" Padding="17,10"/><Button x:Name="EmptyFolder" Content="选择文件夹" Style="{DynamicResource GhostButton}" Click="ChooseFolderClick" Padding="17,10" Margin="10,0,0,0"/></StackPanel>
     <TextBlock x:Name="EmptyHint" Text="也可以将多个文件直接拖到这里" Foreground="#AAAEBB" FontSize="10" TextAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="FoldersPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,28,14,0">
     <TextBlock Text="把收藏的故事，带进书库。" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="添加漫画所在的目录，自动发现其中的书籍。&#xA;应用运行时每分钟检查一次；原始文件和阅读记录始终保留。" Foreground="#818593" FontSize="13" LineHeight="24" Margin="0,14,0,22" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal"><Button Content="＋  添加漫画目录" Click="ChooseFolderClick" Style="{DynamicResource PrimaryButton}" Padding="17,10"/><Button Content="立即更新" Click="RefreshSourcesClick" Style="{DynamicResource GhostButton}" Margin="10,0,0,0" Padding="17,10"/></StackPanel>
     <TextBlock Text="已添加的目录" FontSize="15" FontWeight="SemiBold" Margin="0,37,0,16"/>
     <ItemsControl x:Name="FolderList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E6E8EF" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="19" Foreground="#8998BA" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/><Button Grid.Column="2" Content="停止扫描" Style="{DynamicResource GhostButton}" Click="RemoveFolderClick" Margin="12,0,0,0" Padding="12,7"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock x:Name="NoFoldersText" Text="尚未添加目录。也可以先通过“导入漫画”添加单独的书籍。" Foreground="#9AA0AD" FontSize="12" TextWrapping="Wrap"/>
     <Border Background="#ECEEF5" CornerRadius="9" Padding="18" Margin="0,22,0,0"><TextBlock Text="支持 ZIP / CBZ、EPUB、PDF、MOBI 和图片文件夹。&#xA;暂时离线或移动的文件会标记为不可用。停止扫描仅移除来源，不会移除书库中的书籍。" FontSize="12" Foreground="#8690A5" LineHeight="23" TextWrapping="Wrap"/></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid x:Name="PaginationPanel" Grid.Row="4" Margin="0,12,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageInfo" Foreground="#9A9FAC" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PreviousPage" Content="‹" Style="{DynamicResource IconButton}" Click="PreviousPageClick" ToolTip="上一页"/><TextBlock x:Name="PageLabel" Foreground="#818593" FontSize="11" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextPage" Content="›" Style="{DynamicResource IconButton}" Click="NextPageClick" ToolTip="下一页"/></StackPanel></Grid>
  </Grid>
 </Grid>
</UserControl>
