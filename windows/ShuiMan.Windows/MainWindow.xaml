<Window x:Class="ShuiMan.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ShuiMan.Windows" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="水漫 · 你的私人书库" Width="1320" Height="880" MinWidth="980" MinHeight="640" Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource Ink}" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#FAFAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="56">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="23,0" VerticalAlignment="Center"><Border Background="{StaticResource Accent}" CornerRadius="9" Width="29" Height="29"><TextBlock Text="水" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="水漫" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/><TextBlock Text="SHUIMAN" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,2,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Border Background="#ECEEF3" CornerRadius="8" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="BackToLibraryButton" Content="书库" Click="BackToLibraryClick" Background="White" BorderThickness="0" Padding="19,5" MinHeight="29"/><Button x:Name="ResumeReaderButton" Content="阅读" Click="ResumeReaderClick" Style="{StaticResource GhostButton}" Padding="19,5" MinHeight="29" IsEnabled="False"/></StackPanel></Border>
     <TextBlock x:Name="BookTitle" Text="你的私人书库" Foreground="{StaticResource MutedBrush}" Margin="18,0,12,0" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="打开" Click="OpenFileClick" Style="{StaticResource GhostButton}" ToolTip="打开书籍 · Ctrl+O" Margin="0,0,3,0"/>
     <Button Content="&#xE946;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="HelpClick" ToolTip="帮助与快捷键" Margin="0,0,13,0"/>
     <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeClick" AutomationProperties.Name="最小化"/>
     <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeClick" AutomationProperties.Name="最大化或还原"/>
     <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseClick" AutomationProperties.Name="关闭"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <local:LibraryView x:Name="LibraryHome"/>
   <Grid x:Name="ReaderHost" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#FAFAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
     <DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
       <Button Content="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Click="SidebarClick" Style="{StaticResource IconButton}" ToolTip="页面与目录侧栏" Margin="0,0,10,0"/>
       <ComboBox x:Name="LayoutBox" Width="90" SelectionChanged="PreferenceChanged" ToolTip="页面布局" Margin="0,0,8,0"><ComboBoxItem Content="单页" IsSelected="True"/><ComboBoxItem Content="双页"/></ComboBox>
       <ComboBox x:Name="DirectionBox" Width="123" SelectionChanged="PreferenceChanged" ToolTip="阅读方向" Margin="0,0,8,0"><ComboBoxItem Content="从左到右" IsSelected="True"/><ComboBoxItem Content="从右到左"/></ComboBox>
       <ComboBox x:Name="FitBox" Width="123" SelectionChanged="PreferenceChanged" ToolTip="缩放适配"><ComboBoxItem Content="适合整页" IsSelected="True"/><ComboBoxItem Content="适合宽度"/><ComboBoxItem Content="原始大小"/></ComboBox>
       <Border Width="1" Background="{StaticResource BorderBrush}" Margin="14,6"/>
       <Button Content="−" Click="ZoomOutClick" Style="{StaticResource IconButton}" ToolTip="缩小"/><TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Width="46" TextAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}"/><Button Content="+" Click="ZoomInClick" Style="{StaticResource IconButton}" ToolTip="放大"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button x:Name="BookmarkButton" Content="☆" Click="ToggleBookmarkClick" Style="{StaticResource IconButton}" ToolTip="添加或移除书签 · Ctrl+B"/>
       <Button x:Name="CorrectionButton" Content="修正" Click="CorrectionsClick" Style="{StaticResource GhostButton}" Margin="5,0"><Button.ContextMenu><ContextMenu>
        <MenuItem Header="向右旋转 90°" Click="RotateRightClick"/><MenuItem Header="向左旋转 90°" Click="RotateLeftClick"/><Separator/>
        <MenuItem Header="与下一页配对" Click="PairClick"/><MenuItem Header="交换双图左右" Click="SwapClick"/><MenuItem Header="取消配对 / 单独显示" Click="UnpairClick"/>
        <MenuItem Header="接缝微调…" Click="SeamClick"/><Separator/><MenuItem Header="恢复当前页自动识别" Click="ResetCorrectionClick"/>
       </ContextMenu></Button.ContextMenu></Button>
       <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Click="CorrectionsClick" Style="{StaticResource IconButton}" ToolTip="阅读设置"><Button.ContextMenu><ContextMenu>
        <MenuItem x:Name="SmartMenu" Header="智能大跨页" IsCheckable="True" IsChecked="True" Click="SettingClick"/><MenuItem x:Name="PairsMenu" Header="自动识别相邻双图" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
        <MenuItem x:Name="AggressiveMenu" Header="积极识别相邻跨页（与 macOS 一致）" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
        <MenuItem x:Name="OrientationMenu" Header="智能文字朝向与自动转向" IsCheckable="True" IsChecked="True" Click="SettingClick"/><MenuItem x:Name="CoverMenu" Header="封面单独显示" IsCheckable="True" IsChecked="True" Click="SettingClick"/><Separator/>
        <MenuItem Header="重新分析整本漫画" Click="ReanalyzeClick"/><Separator/>
        <MenuItem x:Name="DarkMenu" Header="深色阅读背景" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
       </ContextMenu></Button.ContextMenu></Button>
       <Button Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Click="FullScreenClick" Style="{StaticResource IconButton}" ToolTip="全屏 · F11" Margin="8,0,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SidebarBrush}">
      <TabControl x:Name="Sidebar" Background="Transparent" BorderThickness="0" Padding="8" Margin="6,10,6,0">
       <TabItem Header="页面"><ListBox x:Name="PageList" SelectionChanged="PageSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Image Source="{Binding Thumbnail}" Width="46" Height="62" Margin="0,0,10,0" Stretch="Uniform"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Number}" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" MaxWidth="116" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
       <TabItem Header="目录"><ListBox x:Name="TocList" DisplayMemberPath="Title" SelectionChanged="TocSelected"/></TabItem>
       <TabItem Header="书签"><ListBox x:Name="BookmarkList" DisplayMemberPath="Title" SelectionChanged="BookmarkSelected"/></TabItem>
      </TabControl>
     </Border>
     <Grid Grid.Column="1" x:Name="ReadingArea" Background="#20242B">
      <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ViewportSizeChanged" PreviewMouseWheel="OnWheel" PanningMode="Both"><local:PageSurface x:Name="Surface" MouseLeftButtonDown="CanvasMouseDown" MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp"/></ScrollViewer>
      <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="让阅读，像水一样自然。" Foreground="#EDF0F6" FontSize="27"/><TextBlock Text="打开一本书，开始阅读" Foreground="#8E96A4" HorizontalAlignment="Center" Margin="0,15,0,0"/></StackPanel>
      <Border x:Name="PageError" Visibility="Collapsed" Background="#FAFAFC" CornerRadius="12" MaxWidth="560" Padding="30" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PageErrorText" TextWrapping="Wrap"/></Border>
     </Grid>
    </Grid>
    <Border x:Name="ReaderFooter" Grid.Row="2" Background="#FAFAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Click="PreviousClick" Style="{StaticResource IconButton}" ToolTip="上一页"/><TextBox x:Name="PageNumber" Width="52" Text="1" KeyDown="JumpKeyDown" TextAlignment="Center" Padding="5" ToolTip="输入页码后按 Enter"/><TextBlock x:Name="PageTotal" Text=" / 0" VerticalAlignment="Center" Margin="9,0" Foreground="{StaticResource MutedBrush}"/><Button x:Name="NextPageButton" Content="›" Click="NextClick" Style="{StaticResource IconButton}" ToolTip="下一页"/><Button Content="下一卷 →" Click="NextBookClick" Style="{StaticResource GhostButton}" Margin="13,0,0,0"/></StackPanel><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="SmartStatusButton" Content="智能跨页：开" Style="{StaticResource GhostButton}" Click="SmartStatusClick" MinHeight="23" Padding="0,2,15,2" FontSize="11" Foreground="{StaticResource Accent}" ToolTip="自动识别横向大图与相邻双图，点击切换"/><Button x:Name="OrientationStatusButton" Content="智能转向：开" Style="{StaticResource GhostButton}" Click="SmartStatusClick" MinHeight="23" Padding="0,2" FontSize="11" Foreground="{StaticResource Accent}" ToolTip="无 EPUB 方向标记时识别文字朝向；明确标记始终遵循，点击切换自动识别"/><TextBlock x:Name="AnalysisStatusText" Text="整本后台分析" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="18,0,8,0" VerticalAlignment="Center"/><Button x:Name="ApplyAnalysisButton" Content="应用识别" Click="ApplyAnalysisClick" Style="{StaticResource GhostButton}" Padding="6,2" MinHeight="23" FontSize="11" Visibility="Collapsed" ToolTip="应用后台找到的当前页结果；翻页时会自动使用缓存结果"/></StackPanel><TextBlock x:Name="StatusText" Text="准备就绪" TextTrimming="CharacterEllipsis" Margin="0,2,15,0" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DockPanel>
    </Border>
   </Grid>
   <Border x:Name="BusyBanner" Visibility="Collapsed" Background="#ED303744" CornerRadius="10" Padding="20,11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" IsHitTestVisible="False"><TextBlock x:Name="BusyText" Foreground="White" Text="正在打开…"/></Border>
  </Grid>
 </Grid>
 </Border>
</Window>
