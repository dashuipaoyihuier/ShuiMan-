<Window x:Class="ShuiMan.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ShuiMan.Windows" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="水漫 · 本地漫画阅读器" Width="1280" Height="850" MinWidth="900" MinHeight="600" Background="#F3F9F8" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#D4E7E5" BorderThickness="0,0,0,1" Padding="14,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="水漫" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,18,0"/><Button Content="打开文件" Click="OpenFileClick" ToolTip="Ctrl+O"/><Button Content="图片文件夹" Click="OpenFolderClick"/><Button Content="导入书库" Click="ImportClick"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="侧栏" Click="SidebarClick"/><Button Content="全屏" Click="FullScreenClick" ToolTip="F11"/><Button Content="帮助" Click="HelpClick"/></StackPanel>
    <TextBlock x:Name="BookTitle" Text="本地阅读，自在翻页" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="18,0" FontWeight="SemiBold"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="Sidebar" Background="#F3F9F8" BorderThickness="0,0,1,0" BorderBrush="#D4E7E5" Padding="0">
    <TabItem Header="书库">
     <DockPanel Margin="6">
      <StackPanel DockPanel.Dock="Top"><TextBox x:Name="LibrarySearch" TextChanged="SearchChanged" ToolTip="按书名或系列搜索" AutomationProperties.Name="搜索书库"/><ComboBox x:Name="LibraryFilter" SelectionChanged="SearchChanged"><ComboBoxItem Content="全部书籍" IsSelected="True"/><ComboBoxItem Content="收藏"/><ComboBoxItem Content="在读"/><ComboBoxItem Content="已读"/></ComboBox><TextBlock x:Name="LibraryCount" Margin="10,6" Foreground="#61868B"/></StackPanel>
      <ListBox x:Name="LibraryList" BorderThickness="0" Background="Transparent" MouseDoubleClick="LibraryOpen" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Series}" FontSize="11" Foreground="#61868B" Margin="0,4,0,0"/><TextBlock Text="{Binding ReadState}" FontSize="11"/><TextBlock FontSize="11" Foreground="#61868B"><Run Text="{Binding Position}"/><Run Text=" / "/><Run Text="{Binding Total}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
       <ListBox.ContextMenu><ContextMenu><MenuItem Header="打开 / 继续阅读" Click="LibraryOpen"/><MenuItem Header="收藏 / 取消收藏" Click="FavoriteClick"/><MenuItem Header="标记为已读" Click="FinishedClick"/><MenuItem Header="重命名书名" Click="RenameClick"/><MenuItem Header="从书库移除（保留文件）" Click="RemoveClick"/></ContextMenu></ListBox.ContextMenu>
      </ListBox>
     </DockPanel>
    </TabItem>
    <TabItem Header="页面"><ListBox x:Name="PageList" SelectionChanged="PageSelected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><DockPanel><Image Source="{Binding Thumbnail}" Width="52" Height="68" Margin="0,0,8,0" Stretch="Uniform"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Number}" FontWeight="Bold"/><TextBlock Text="{Binding Title}" MaxWidth="158" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
    <TabItem Header="目录"><ListBox x:Name="TocList" DisplayMemberPath="Title" SelectionChanged="TocSelected" Background="Transparent" BorderThickness="0"/></TabItem>
    <TabItem Header="书签"><ListBox x:Name="BookmarkList" DisplayMemberPath="Title" SelectionChanged="BookmarkSelected" Background="Transparent" BorderThickness="0"/></TabItem>
   </TabControl>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel x:Name="ReaderToolbar" Background="#E7F2F1" Margin="0" VerticalAlignment="Center">
     <ComboBox x:Name="LayoutBox" SelectionChanged="PreferenceChanged" ToolTip="页面布局"><ComboBoxItem Content="单页" IsSelected="True"/><ComboBoxItem Content="双页"/></ComboBox>
     <ComboBox x:Name="DirectionBox" SelectionChanged="PreferenceChanged" ToolTip="阅读方向"><ComboBoxItem Content="从左到右" IsSelected="True"/><ComboBoxItem Content="从右到左"/></ComboBox>
     <ComboBox x:Name="FitBox" SelectionChanged="PreferenceChanged" ToolTip="缩放适配"><ComboBoxItem Content="适合整页" IsSelected="True"/><ComboBoxItem Content="适合宽度"/><ComboBoxItem Content="原始大小"/></ComboBox>
     <Button Content="−" Click="ZoomOutClick" ToolTip="缩小"/><TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="3"/><Button Content="+" Click="ZoomInClick" ToolTip="放大"/>
     <Button x:Name="BookmarkButton" Content="☆ 书签" Click="ToggleBookmarkClick" ToolTip="Ctrl+B"/>
     <Button x:Name="CorrectionButton" Content="页面修正 ▾" Click="CorrectionsClick"><Button.ContextMenu><ContextMenu>
      <MenuItem Header="向右旋转 90°" Click="RotateRightClick"/><MenuItem Header="向左旋转 90°" Click="RotateLeftClick"/>
      <MenuItem Header="与下一页配对" Click="PairClick"/><MenuItem Header="交换双图左右" Click="SwapClick"/><MenuItem Header="取消配对 / 单独显示" Click="UnpairClick"/>
      <MenuItem Header="接缝微调…" Click="SeamClick"/><Separator/><MenuItem Header="恢复当前页自动识别" Click="ResetCorrectionClick"/>
     </ContextMenu></Button.ContextMenu></Button>
     <Button Content="阅读设置 ▾" Click="CorrectionsClick"><Button.ContextMenu><ContextMenu>
      <MenuItem x:Name="SmartMenu" Header="智能大跨页" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
      <MenuItem x:Name="PairsMenu" Header="自动识别相邻双图" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
      <MenuItem x:Name="OrientationMenu" Header="使用页面旋转线索" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
      <MenuItem x:Name="CoverMenu" Header="封面单独显示" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
      <MenuItem x:Name="DarkMenu" Header="深色阅读背景" IsCheckable="True" IsChecked="True" Click="SettingClick"/>
     </ContextMenu></Button.ContextMenu></Button>
    </WrapPanel>
    <Grid Grid.Row="1" x:Name="ReadingArea" Background="#15262D">
     <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ViewportSizeChanged" PreviewMouseWheel="OnWheel" PanningMode="Both">
      <local:PageSurface x:Name="Surface" MouseLeftButtonDown="CanvasMouseDown" MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp"/>
     </ScrollViewer>
     <wv:WebView2 x:Name="BookWeb" Visibility="Collapsed"/>
     <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
      <Image Source="Assets/WaterCover.png" Width="190" Height="245" Stretch="UniformToFill" Margin="0,0,0,25"/>
      <TextBlock Text="让阅读，像水一样自然。" Foreground="#E5F6F4" FontSize="27" HorizontalAlignment="Center"/>
      <TextBlock Text="打开一本书，或将文件拖到这里" Foreground="#A8CACB" HorizontalAlignment="Center" Margin="0,15,0,7"/>
      <TextBlock Text="ZIP · CBZ · 图片文件夹 · PDF · EPUB · MOBI" Foreground="#A8CACB" HorizontalAlignment="Center"/>
      <TextBlock Text="阅读进度、书签和页面修正保存在本机" Foreground="#6D979F" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12"/>
     </StackPanel>
     <Border x:Name="PageError" Visibility="Collapsed" Background="#EAF5F4" MaxWidth="600" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PageErrorText" TextWrapping="Wrap"/></Border>
     <Border x:Name="BusyBanner" Visibility="Collapsed" Background="#E6087180" Padding="20,9" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="0,0,8,8"><TextBlock x:Name="BusyText" Foreground="White" Text="正在打开…"/></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#D4E7E5" BorderThickness="0,1,0,0" Padding="12,6">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Click="PreviousClick"/><TextBox x:Name="PageNumber" Width="56" Text="1" KeyDown="JumpKeyDown" ToolTip="输入页码后按 Enter"/><TextBlock x:Name="PageTotal" Text=" / 0" VerticalAlignment="Center"/><Button Content="下一页" Click="NextClick"/><Button Content="下一卷" Click="NextBookClick"/></StackPanel><TextBlock x:Name="StatusText" Text="准备就绪 · Ctrl+O 打开文件" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,15,0"/></DockPanel>
  </Border>
 </Grid>
</Window>
